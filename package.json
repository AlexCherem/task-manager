{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project storybook",
    "test:watch": "vitest --project unit --project storybook",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:install-browser": "playwright install chromium",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "db:check": "node --experimental-strip-types --env-file=.env.local --conditions=react-server scripts/check-db.mjs",
    "db:setup": "node --experimental-strip-types --env-file=.env.local --conditions=react-server scripts/setup-db.mjs",
    "test:database": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --project database"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "antd": "^6.6.8",
    "dayjs": "1.11.23",
    "jose": "^6.2.14",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "prettier": "^3.6.2",
    "storybook": "^10.6.5",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
